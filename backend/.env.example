# ─────────────────────────────────────────────────────────────────────────────
# FileForge — Backend Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the real values below
# 3. NEVER commit .env to Git  (it's already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=FileForge
APP_VERSION=1.0.0
DEBUG=false                        # set to true for local dev

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=FileForge
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fileforge

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080           # 7 days

# ── File Storage ─────────────────────────────────────────────────────────────
TMP_DIR=./tmp
MAX_FILE_SIZE_MB=20                # max upload size (1–200)

# ── Cleanup Policy ───────────────────────────────────────────────────────────
FILE_EXPIRY_MINUTES=30             # anonymous user files
AUTH_EXPIRY_MINUTES=1440           # logged-in user files (24 h)
POST_DOWNLOAD_EXPIRY_MINUTES=5     # after download, delete file
CLEANUP_INTERVAL_MINUTES=5        # background cleanup interval

# ── Rate Limiting ─────────────────────────────────────────────────────────────
ANON_RATE_LIMIT=10/hour            # per IP
AUTH_RATE_LIMIT=100/hour           # per account

# ── CORS ─────────────────────────────────────────────────────────────────────
# Local:       http://localhost:3000
# Production:  https://your-frontend.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
