# ─────────────────────────────────────────────────────────────────────────────
# FileForge — Frontend Environment Variables (Next.js)
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in the real values below
# 3. NEVER commit .env.local to Git  (it's already in .gitignore)
#
# Rules:
#   - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   - Variables WITHOUT the prefix are server-side only (API routes / SSR).
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local dev:    leave empty — Next.js proxy rewrites /api/* to localhost:8000
# Production:   set to your deployed backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=

# ── App Metadata ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FileForge
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Feature Flags (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_MAX_FILE_SIZE_MB=20    # shown in UI upload hints
